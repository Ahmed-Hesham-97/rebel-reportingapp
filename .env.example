NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
# Local: http://localhost:3000 — Production: https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-server-only-supabase-secret
ENCRYPTION_KEY=base64-or-hex-encoded-32-byte-key
RESEND_API_KEY=re_...
CRON_SECRET=replace-with-a-long-random-secret

# Optional global fallback. Prefer saving Client ID + secret per client in Settings
# (one Custom-distribution app per store in the Shopify Dev Dashboard).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
